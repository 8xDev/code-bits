# Copy this to .env and edit before running

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=posts_db
DATABASE_URL=postgres://postgres:postgres@postgres:5432/posts_db?sslmode=disable

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=posts-media
MINIO_PUBLIC_BASE=http://localhost:9000  # used to build public URLs for simple dev

# App
APP_PORT=8080
API_KEY=changeme_api_key_please_change
MAX_UPLOAD_MB=10
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Worker
WORKER_PORT=9002
